{
  "name": "funmental",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node api.js && vite",
    "build": "node api.js && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
